<Window x:Class="BtBattery.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="蓝牙电量"
        Width="360"
        SizeToContent="Height"
        MaxHeight="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#E6F3F3F3"/>
    <SolidColorBrush x:Key="CardBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5E5E5E"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#22000000"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Padding="16,14" Background="{DynamicResource WindowBrush}" CornerRadius="8">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
        <StackPanel Margin="0,0,120,0">
          <TextBlock Text="已连接的配件" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubtitleText" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Content="刷新" Click="OnRefresh" Margin="0,0,6,0"/>
          <Button Content="设置" Click="OnSettings"/>
        </StackPanel>
      </Grid>

      <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" Margin="2,12,2,2"
                 Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12"
                 Text="部分配件不会把电量告诉 Windows，这时电池是空的，并显示「电量未知」。"/>

      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
        <StackPanel>
          <Border x:Name="EmptyState" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" LineHeight="20"/>
          </Border>
          <ItemsControl x:Name="DeviceList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Width="32" Height="32" VerticalAlignment="Center" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                      <Grid Height="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding Fill}"/>
                          <ColumnDefinition Width="{Binding Rest}"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding BarBrush}" CornerRadius="2"/>
                        <Border Grid.Column="1" Background="{DynamicResource StrokeBrush}" CornerRadius="2"/>
                      </Grid>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding BatteryText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
